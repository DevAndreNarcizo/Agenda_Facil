# Supabase Configuration
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable-aqui

# Supabase CLI / migrations
# Gere em: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=seu-access-token-supabase

# Project ref do Supabase. Fica na URL do projeto:
# https://supabase.com/dashboard/project/<PROJECT_REF>
SUPABASE_PROJECT_REF=seu-project-ref

# Senha do banco Postgres do projeto Supabase.
SUPABASE_DB_PASSWORD=sua-senha-do-banco

# Opcional: URL Postgres completa para rodar migrations direto com --db-url.
# Você encontra a connection string em Project Settings > Database.
SUPABASE_DB_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
